{
  "name": "crysound-design-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @crysound/docs",
    "build": "npm run build -w @crysound/tokens && npm run build -w @crysound/ui && npm run build -w @crysound/docs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "tokens:sync": "node scripts/sync-tokens.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
